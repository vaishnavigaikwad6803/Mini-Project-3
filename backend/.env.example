# ==============================================================================
# RoadGuard AI – Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure with your actual service credentials.
# Never commit real credentials or secret keys to version control.

# Application Information
PROJECT_NAME="RoadGuard AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & JSON Web Tokens
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="roadguard-ai-secret-key-change-this-in-production-use-strong-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: SQLite (Default out-of-the-box local database with full persistence)
DB_TYPE="sqlite"
DATABASE_URL="sqlite:///roadguard.db"

# Option 2: MySQL / MariaDB (Set DB_TYPE=mysql and specify credentials below)
# DB_TYPE="mysql"
# DB_HOST="localhost"
# DB_PORT=3306
# DB_NAME="roadguard"
# DB_USER="root"
# DB_PASSWORD="your_mysql_password"
# Alternatively, set full connection string:
# DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/roadguard?charset=utf8mb4"

# ==============================================================================
# Email Delivery (SMTP) Configuration
# ==============================================================================
# Supported providers: Gmail (App Password), Resend SMTP, SendGrid, Mailgun, Amazon SES, or custom SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-secure-smtp-app-password"
SMTP_FROM_EMAIL="no-reply@roadguard.ai"
SMTP_FROM_NAME="RoadGuard AI Civil Infrastructure"
SMTP_TLS=true
SMTP_SSL=false

# Email Service Operating Mode
# Options:
#   'smtp'                 - Sends live emails through the configured SMTP provider
#   'development_fallback' - In test/local mode without live credentials, safely queues emails to dev inbox
EMAIL_SERVICE_MODE="smtp"

# Frontend Application URL (for generating email action links e.g. password reset)
FRONTEND_URL="http://localhost:5173"

# Authentication Security Policies
OTP_EXPIRE_MINUTES=5
PASSWORD_RESET_EXPIRE_MINUTES=15
RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# YOLO AI Defect Detection
YOLO_MODEL_PATH="yolov8n.pt"
AI_CONFIDENCE_THRESHOLD=0.25
AI_DEMO_FALLBACK=true
